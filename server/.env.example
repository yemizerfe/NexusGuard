# Copy to server/.env and fill in real values.
# NEVER commit server/.env - it is gitignored.

# JWT signing secret (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
# Database (compose overrides this to point at the `db` service)
DATABASE_URL=postgresql+asyncpg://postgres:12345@localhost:5432/nexusguard

# Google Gemini AI key (optional - falls back to local analyzer)
# Must be a Gemini API key starting with "AIza" - get one free at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Redis (optional task queue; compose overrides to redis service)
REDIS_URL=redis://localhost:6379/0

# Frontend origin used when building local password-reset links
FRONTEND_URL=http://localhost:5173

# Optional: comma-separated extra CORS origins (defaults cover localhost dev ports)
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080
